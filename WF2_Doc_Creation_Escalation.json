    {
      "parameters": {
        "sendTo": "YOUR_CTO_EMAIL@example.com",
        "subject": "={{ $('Webhook - Entry from WF1').item.json.body.severity === 'High' ? '\ud83d\udea8 HIGH SEVERITY INCIDENT \u2014 ' + $('Webhook - Entry from WF1').item.json.body.incident_title + ' [ARIA Alert]' : 'SKIP' }}",
        "emailType": "html",
        "message": "={% if $('Webhook - Entry from WF1').item.json.body.severity === 'High' %}\n<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:0 auto\">\n\n<div style=\"background:#B91C1C;color:white;padding:16px 24px;border-radius:8px 8px 0 0\">\n  <h2 style=\"margin:0;font-size:18px\">\ud83d\udea8 ARIA High Severity Incident Alert</h2>\n  <p style=\"margin:4px 0 0;font-size:13px;opacity:0.85\">Automated Response & Intelligence Analyst \u2014 Production Pipeline</p>\n</div>\n\n<div style=\"border:1px solid #E5E7EB;border-top:none;border-radius:0 0 8px 8px;padding:24px\">\n\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:24px\">\n    <tr style=\"background:#FEF2F2\">\n      <td style=\"padding:10px 14px;border:1px solid #FECACA;font-weight:bold;width:180px\">Incident ID</td>\n      <td style=\"padding:10px 14px;border:1px solid #FECACA\">{{ $('Webhook - Entry from WF1').item.json.body.incident_id }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB;font-weight:bold\">Incident Title</td>\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB\">{{ $('Webhook - Entry from WF1').item.json.body.incident_title }}</td>\n    </tr>\n    <tr style=\"background:#FEF2F2\">\n      <td style=\"padding:10px 14px;border:1px solid #FECACA;font-weight:bold\">Severity</td>\n      <td style=\"padding:10px 14px;border:1px solid #FECACA;color:#B91C1C;font-weight:bold\">\ud83d\udd34 HIGH</td>\n    </tr>\n    <tr>\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB;font-weight:bold\">Queue Timestamp</td>\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB\">{{ $('Webhook - Entry from WF1').item.json.body.incident_timestamp }}</td>\n    </tr>\n    <tr style=\"background:#F9FAFB\">\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB;font-weight:bold\">Analysis Model</td>\n      <td style=\"padding:10px 14px;border:1px solid #E5E7EB\">{{ $('Webhook - Entry from WF1').item.json.body.model_used }}</td>\n    </tr>\n  </table>\n\n  <div style=\"background:#FFF7ED;border-left:4px solid #F97316;padding:14px 18px;margin-bottom:16px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 8px;font-size:14px;color:#C2410C\">Root Cause</h3>\n    <p style=\"margin:0;font-size:14px;color:#1F2937\">{{ $('Webhook - Entry from WF1').item.json.body.root_cause }}</p>\n  </div>\n\n  <div style=\"background:#EFF6FF;border-left:4px solid #3B82F6;padding:14px 18px;margin-bottom:16px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 8px;font-size:14px;color:#1D4ED8\">Business Impact</h3>\n    <p style=\"margin:0;font-size:14px;color:#1F2937\">{{ $('Webhook - Entry from WF1').item.json.body.business_impact }}</p>\n  </div>\n\n  <div style=\"background:#F0FDF4;border-left:4px solid #22C55E;padding:14px 18px;margin-bottom:24px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 8px;font-size:14px;color:#15803D\">Recommended Immediate Action</h3>\n    <p style=\"margin:0;font-size:14px;color:#1F2937\">{{ $('Webhook - Entry from WF1').item.json.body.recommended_action }}</p>\n  </div>\n\n  <div style=\"background:#F9FAFB;border:1px solid #E5E7EB;border-radius:6px;padding:14px 18px;margin-bottom:24px\">\n    <h3 style=\"margin:0 0 8px;font-size:14px;color:#374151\">Full Post-Mortem</h3>\n    <p style=\"margin:0;font-size:14px;color:#4B5563;line-height:1.6\">{{ $('Webhook - Entry from WF1').item.json.body.post_mortem }}</p>\n  </div>\n\n  <div style=\"text-align:center;margin-bottom:8px\">\n    <a href=\"https://docs.google.com/document/d/{{ $json.id }}/edit\"\n       style=\"background:#1D4ED8;color:white;padding:12px 28px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:bold;display:inline-block\">\n      \ud83d\udcc4 View Full ARIA Report in Google Docs\n    </a>\n  </div>\n\n  <p style=\"text-align:center;font-size:11px;color:#9CA3AF;margin-top:16px\">\n    Generated by ARIA \u2014 Automated Response & Intelligence Analyst v2.0<br>\n    Automated Incident Response System | Run Logs tab contains full audit trail\n  </p>\n</div>\n</div>\n{% endif %}",
        "options": {
          "maxRetries": 2
        }
