        [
          {
            "node": "AI Agent - Incident Commander",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Primary Model - Mistral 7B": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - Incident Commander",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Fallback Model - GPT-3.5 Turbo": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent - Incident Commander",
            "type": "ai_languageModel",
            "index": 1
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "AI Agent - Incident Commander",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent - Incident Commander": {
