            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set - Parse Error Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Validated Payload": {
      "main": [
        [
          {
            "node": "Execute Workflow 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Parse Error Payload": {
      "main": [
        [
          {
            "node": "Execute Workflow 3 - Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "YOUR_WF3_ID_HERE",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "executionTimeout": 300
  },
  "meta": {
