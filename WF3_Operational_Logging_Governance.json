              "name": "human_reviewed",
              "value": "={{ $json.body.approval_decision === 'approved' ? 'YES' : 'NO \u2014 pending manual triage' }}",
              "type": "string"
            },
            {
              "id": "qa_g01",
              "name": "qa_severity_valid",
              "value": "={{ $json.body.qa_severity_valid ?? 'not checked' }}",
              "type": "string"
            },
            {
              "id": "qa_g02",
