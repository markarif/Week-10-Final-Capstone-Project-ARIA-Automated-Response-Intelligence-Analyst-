              "id": "qa_g04",
              "name": "qa_all_fields_present",
              "value": "={{ $json.body.qa_all_fields_present ?? 'not checked' }}",
              "type": "string"
            },
            {
              "id": "qa_g05",
              "name": "overall_qa_status",
              "value": "={{ [$json.body.qa_severity_valid, $json.body.qa_all_fields_present].every(v => v === 'PASS') ? 'QA PASSED' : [$json.body.qa_severity_valid, $json.body.qa_all_fields_present].some(v => v === 'FAIL') ? 'QA FAILED' : 'QA WARNED' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
