            {
              "id": "g11",
              "name": "sheet_updated",
              "value": "={{ $json.body.sheet_updated ?? 'unknown' }}",
              "type": "string"
            },
            {
              "id": "g12",
              "name": "root_cause_logged",
              "value": "={{ $json.body.root_cause ? $json.body.root_cause.substring(0, 120) : 'not captured' }}",
              "type": "string"
            },
            {
              "id": "g13",
              "name": "recommended_action_logged",
              "value": "={{ $json.body.recommended_action ? $json.body.recommended_action.substring(0, 120) : 'not captured' }}",
              "type": "string"
            },
            {
              "id": "g14",
              "name": "error_reason",
              "value": "={{ $json.body.error_reason ?? 'none' }}",
              "type": "string"
            },
            {
              "id": "g15",
              "name": "workflow_version",
              "value": "v2.0 \u2014 ARIA Production | Week 10",
              "type": "string"
            },
            {
              "id": "g16",
              "name": "overall_run_health",
              "value": "={{ $json.body.processing_status === 'success' && $json.body.doc_created !== 'no \u2014 doc node failed' ? 'HEALTHY' : $json.body.processing_status === 'pending_review' ? 'PENDING REVIEW' : $json.body.processing_status === 'success' ? 'PARTIAL' : 'FAILED' }}",
              "type": "string"
            },
            {
              "id": "g17",
              "name": "escalation_required",
              "value": "={{ $json.body.severity === 'High' ? 'YES \u2014 CTO alerted' : 'NO' }}",
              "type": "string"
            },
            {
              "id": "g18",
              "name": "pipeline_stage_reached",
