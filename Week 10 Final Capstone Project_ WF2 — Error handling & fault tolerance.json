    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "Markmuinde78@gmail.com",
        "subject": "=[ARIA] Action required — review incident {{ $json.incident_id }}: {{ $json.incident_title }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:0 auto;border:1px solid #E5E7EB;border-radius:10px;overflow:hidden\">\n\n<div style=\"background:#1E3A5F;color:white;padding:20px 28px\">\n  <h2 style=\"margin:0;font-size:17px;font-weight:600\">ARIA — Human Review Required</h2>\n  <p style=\"margin:6px 0 0;font-size:12px;opacity:0.75\">Automated Response & Intelligence Analyst v2.0</p>\n</div>\n\n<div style=\"padding:24px 28px;background:#F9FAFB\">\n  <p style=\"margin:0 0 16px;font-size:14px;color:#374151\">\n    ARIA has completed its analysis of the following incident. Your approval is required before a Google Doc report is created.\n    <strong>This request expires in 30 minutes.</strong> No action = auto-rejected and logged.\n  </p>\n\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:20px;background:white;border-radius:8px;overflow:hidden;border:1px solid #E5E7EB\">\n    <tr style=\"background:#F3F4F6\">\n      <td style=\"padding:10px 14px;font-weight:600;font-size:13px;color:#111827;width:170px\">Incident ID</td>\n      <td style=\"padding:10px 14px;font-size:13px;color:#374151\">{{ $json.incident_id }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:10px 14px;font-weight:600;font-size:13px;color:#111827\">Incident title</td>\n      <td style=\"padding:10px 14px;font-size:13px;color:#374151\">{{ $json.incident_title }}</td>\n    </tr>\n    <tr style=\"background:#F3F4F6\">\n      <td style=\"padding:10px 14px;font-weight:600;font-size:13px;color:#111827\">Severity</td>\n      <td style=\"padding:10px 14px;font-size:13px;font-weight:700;color:{{ $json.severity === 'High' ? '#B91C1C' : $json.severity === 'Medium' ? '#B45309' : '#166534' }}\">{{ $json.severity }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:10px 14px;font-weight:600;font-size:13px;color:#111827\">Queue timestamp</td>\n      <td style=\"padding:10px 14px;font-size:13px;color:#374151\">{{ $json.incident_timestamp }}</td>\n    </tr>\n    <tr style=\"background:#F3F4F6\">\n      <td style=\"padding:10px 14px;font-weight:600;font-size:13px;color:#111827\">Analysis model</td>\n      <td style=\"padding:10px 14px;font-size:13px;color:#374151\">{{ $json.model_used }}</td>\n    </tr>\n  </table>\n\n  <div style=\"background:#FFF7ED;border-left:4px solid #F97316;padding:14px 18px;margin-bottom:14px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 6px;font-size:13px;color:#C2410C;font-weight:600\">Root cause</h3>\n    <p style=\"margin:0;font-size:13px;color:#1F2937;line-height:1.5\">{{ $json.root_cause }}</p>\n  </div>\n\n  <div style=\"background:#EFF6FF;border-left:4px solid #3B82F6;padding:14px 18px;margin-bottom:14px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 6px;font-size:13px;color:#1D4ED8;font-weight:600\">Business impact</h3>\n    <p style=\"margin:0;font-size:13px;color:#1F2937;line-height:1.5\">{{ $json.business_impact }}</p>\n  </div>\n\n  <div style=\"background:#F0FDF4;border-left:4px solid #22C55E;padding:14px 18px;margin-bottom:20px;border-radius:0 6px 6px 0\">\n    <h3 style=\"margin:0 0 6px;font-size:13px;color:#15803D;font-weight:600\">Recommended immediate action</h3>\n    <p style=\"margin:0;font-size:13px;color:#1F2937;line-height:1.5\">{{ $json.recommended_action }}</p>\n  </div>\n\n  <div style=\"background:#F9FAFB;border:1px solid #E5E7EB;border-radius:6px;padding:14px 18px;margin-bottom:28px\">\n    <h3 style=\"margin:0 0 6px;font-size:13px;color:#374151;font-weight:600\">ARIA post-mortem</h3>\n    <p style=\"margin:0;font-size:13px;color:#4B5563;line-height:1.6\">{{ $json.post_mortem }}</p>\n  </div>\n\n  <p style=\"margin:20px 0 0;font-size:11px;color:#9CA3AF;text-align:center\">\n    This request expires in <strong>30 minutes</strong>. No response = auto-rejected and logged as pending review.<br>\n    ARIA — Automated Incident Response System v2.0 | Do not forward this email — links are single-use.\n  </p>\n</div>\n</div>",
        "options": {}
